        {
          "name": "ReqNo",
          "required": true,
          "source": "user",
          "default-value": ""
        }
      ]
    },
    "search-roles": {
      "endpoint": "http://localhost:3001/search-roles",
      "template-path": "templates/search_roles_template.xml",
      "method": "POST",
      "fields": [
        {
          "name": "RoleName",
          "required": true,
          "source": "user",
          "default-value": ""
